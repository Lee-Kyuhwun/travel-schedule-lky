# 복사해서 .env.local 로 저장하세요.

# Google Maps (브라우저 노출 키: HTTP 리퍼러/API 제한 필수)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Supabase (Project Settings > API). publishable 키는 브라우저에 노출되는 공개 키이며 권한은 RLS 가 결정합니다. secret/service role 키는 넣지 마세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
